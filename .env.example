# Optional. Without a key Clarity runs in clearly-labelled DEMO AI mode:
# all manual workflows and deterministic analysis work unchanged.
ANTHROPIC_API_KEY=
# Model used for live AI proposals (server-side only).
CLARITY_AI_MODEL=claude-sonnet-5-5
# Where the SQLite file lives (default: ./data/clarity.db)
CLARITY_DB_PATH=./data/clarity.db
